ALCHEMY_PASSWORD=       # Alchemy state encryption (local dev state)
BETTER_AUTH_SECRET=     # openssl rand -base64 32
BETTER_AUTH_URL=        # set to the URL alchemy dev prints (e.g. http://localhost:1338)
GOOGLE_CLIENT_ID=       # optional — empty disables Google sign-in
GOOGLE_CLIENT_SECRET=
OWNER_ADMIN_EMAIL=      # verified email that becomes admin on sign-up
SIGNUP_DISABLED=        # "true" closes new sign-ups (email + Google)

# --- noomers analytics -------------------------------------------------
VISITOR_SALT=          # daily-rotating visitor-id salt (required for /collect)
SITES_API_TOKEN=       # bearer for /api/v1/*
STATS_API_TOKEN=       # bearer for /api/v2/query (fallback for /api/v1)
SERVER_EVENTS_TOKEN=   # optional first-party server tracker token
CF_ACCOUNT_ID=
CF_TRACKER_SCRIPT_NAME=  # optional custom name for the tracker script
R2_SQL_BUCKET=         # Basin warehouse bucket; empty = Basin not configured
R2_SQL_TABLE=noomers.events
R2_SQL_IMPORT_TABLE=
R2_SQL_TOKEN=          # Basin SQL API token
R2_CATALOG_TOKEN=      # API token with R2 Data Catalog write (sink deploy)
