ALCHEMY_PASSWORD=       # Alchemy state encryption (local dev state)
BETTER_AUTH_SECRET=     # openssl rand -base64 32
BETTER_AUTH_URL=        # set to the URL alchemy dev prints (e.g. http://localhost:1338)
GOOGLE_CLIENT_ID=       # optional — empty disables Google sign-in
GOOGLE_CLIENT_SECRET=
OWNER_ADMIN_EMAIL=      # verified email that becomes admin on sign-up
SIGNUP_DISABLED=        # "true" closes new sign-ups (email + Google)
