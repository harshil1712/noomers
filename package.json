    "@oxlint/plugins": "^1.89.0",
    "@types/node": "24.19.2",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.6",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "alchemy": {
      "drizzle-orm": "0.45.4",
      "drizzle-kit": "1.0.0-rc.4"
    },
