---
/**
 * One decorative crew sprite. The wrapper is real Astro markup (not set:html) so the
 * placement styles below are scoped to it and always apply. Inner art comes from the
 * shared renderer and is styled by the global crew.css.
 *
 * placement:
 *   lane   - absolute, bottom of the hero scene; spread by `index`, nudged by --crew-x
 *   inline - in flow, centred (404, empty states)
 *   block  - in flow, left aligned (the scroll escort)
 */
import { crewSpriteHTML, type CrewRobot } from "@noomers/brand/crew/crew";

interface Props {
  robot: CrewRobot;
  color?: "--crew-1" | "--crew-2" | "--crew-3" | "--crew-4";
  carry?: string;
  flip?: boolean;
  index?: number;
  placement?: "lane" | "inline" | "block";
  class?: string;
}
const {
  robot,
  color = "--crew-1",
  carry,
  flip = false,
  index = 0,
  placement = "inline",
  class: cls,
} = Astro.props;
---
<span
  class:list={["sp", placement, cls]}
  style={placement === "lane" ? `--i:${index}` : undefined}
  aria-hidden="true"
  set:html={crewSpriteHTML(robot, color, carry, flip)}
/>
<style>
  .sp.lane {
    position: absolute;
    bottom: 0;
    left: calc(8% + var(--i, 0) * 22%);
    transform: translateX(var(--crew-x, 0px));
  }
  .sp.inline {
    position: relative;
    display: block;
    margin-inline: auto;
  }
  .sp.block {
    position: relative;
    display: block;
  }
</style>
