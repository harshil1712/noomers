---
import { PROJECT, APP_DOMAIN } from "#project";
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? `https://${APP_DOMAIN}`;
---
<footer>
  <div class="wrap inner">
    <nav aria-label="Footer">
      <a href="/blog/">Blog</a>
      <a href="/privacy">Privacy</a>
      <a href="/rss.xml">RSS</a>
      <a href={APP_URL}>App</a>
    </nav>
    <span>{PROJECT.productName}</span>
  </div>
</footer>
<style>
  .inner {
    border-top: 1px solid var(--color-kumo-line);
    padding-block: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    font-size: 14px;
    color: var(--color-kumo-subtle);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
</style>
