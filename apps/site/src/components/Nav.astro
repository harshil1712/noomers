---
import Logo from "@noomers/brand/Logo.astro";
import { PROJECT, APP_DOMAIN } from "#project";
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? `https://${APP_DOMAIN}`;
const REPO = "https://github.com/harshil1712/noomers";
---
<header class="wrap nav">
  <a class="home" href="/" aria-label={`${PROJECT.productName} home`}>
    <Logo />
  </a>
  <nav aria-label="Main">
    <a href={`${REPO}#readme`}>Docs</a>
    <a href="/blog/">Blog</a>
    <a href={REPO}>GitHub</a>
    <button class="theme" type="button" data-theme-toggle aria-label="Switch to dark theme">
      <svg class="moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.4 14.6A8.5 8.5 0 0 1 9.4 3.6a8.5 8.5 0 1 0 11 11Z"/></svg>
      <svg class="sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <a class="btn cta deploy" href={`${REPO}#deployment`}>Deploy</a>
  </nav>
</header>
<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .home {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    border-radius: 6px;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 14px;
  }
  .theme {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: none;
    color: var(--color-kumo-subtle);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .theme:hover {
    color: var(--color-kumo-default);
    background: var(--color-kumo-recessed);
  }
  .sun,
  :global(html[data-mode="dark"]) .moon {
    display: none;
  }
  :global(html[data-mode="dark"]) .sun {
    display: block;
  }
  .deploy {
    background: var(--color-kumo-brand);
    color: var(--brand-ink);
    padding: 8px 16px;
    border-radius: 10px;
    font-weight: 600;
  }
</style>
<script>
  import { applyTheme, readTheme, resolveTheme } from "@noomers/brand/theme";

  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    const label = () => {
      const next = resolveTheme(readTheme()) === "dark" ? "light" : "dark";
      btn.setAttribute("aria-label", `Switch to ${next} theme`);
    };
    label();
    btn.addEventListener("click", () => {
      applyTheme(resolveTheme(readTheme()) === "dark" ? "light" : "dark");
      label();
    });
  }
</script>
