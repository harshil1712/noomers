---
/** Tags as links to their tag pages. Renders nothing for an empty list. */
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---
{tags.length > 0 && (
  <ul class="tags" aria-label="Tags">
    {tags.map((t) => (
      <li><a class="tag" href={`/blog/tags/${t}/`}>{t}</a></li>
    ))}
  </ul>
)}
<style>
  .tags {
    list-style: none;
    padding: 0;
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    display: inline-block;
    font-size: 12px;
    line-height: 20px;
    padding: 2px 10px;
    border-radius: 999px;
    border: 1px solid var(--color-kumo-line);
    background: var(--color-kumo-recessed);
    color: var(--color-kumo-subtle);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .tag:hover {
    color: var(--color-kumo-default);
    border-color: var(--color-kumo-subtle);
  }
</style>
