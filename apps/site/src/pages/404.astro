---
import PageLayout from "../components/PageLayout.astro";
import { PROJECT } from "#project";
---
<PageLayout
  title={`Page not found · ${PROJECT.productName}`}
  description={`That page doesn't exist. Head back to the ${PROJECT.productName} home page or the blog.`}
>
  <div class="nf">
    <span class="mono-label eyebrow">404</span>
    <h1 class="font-display">Page not found</h1>
    <p>That page doesn't exist. It may have moved, or the link has a typo.</p>
    <div class="links">
      <a class="btn" href="/">Back to home</a>
      <a class="btn btn-secondary" href="/blog/">Read the blog</a>
    </div>
  </div>
</PageLayout>
<style>
  .eyebrow { display: block; }
  .nf h1 {
    font-family: "Inter Tight Variable", "Inter Variable", -apple-system, sans-serif;
    font-size: 36px;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-top: 4px;
  }
  .nf p { color: var(--color-kumo-subtle); }
  .nf {
    min-height: 56vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: center;
  }

  h1 {
    margin-top: 12px;
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  p {
    max-width: 44ch;
    color: var(--color-kumo-subtle);
  }
  .links {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
</style>
