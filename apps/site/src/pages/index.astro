---
import PageLayout from "../components/PageLayout.astro";
import PostList from "../components/PostList.astro";
import { PROJECT } from "#project";
import { getPublishedPosts } from "../lib/posts";

const latest = (await getPublishedPosts()).slice(0, 3);
const description =
  "Privacy-first, self-hosted web analytics on Cloudflare — a lightweight tracker, a realtime dashboard, and Plausible-compatible APIs, all inside your own account.";
const REPO = "https://github.com/harshil1712/noomers";
---
<PageLayout title={`${PROJECT.productName}: privacy-first self-hosted analytics`} description={description} width="wide">
  <section class="hero">
    <span class="mono-label eyebrow">Self-hosted analytics for Cloudflare</span>
    <h1>Analytics that know <span class="kw">less</span>, not more.</h1>
    <p class="sub">Privacy-first web analytics that run in your own Cloudflare account.</p>
    <div class="btns">
      <a class="btn cta" href={`${REPO}#deployment`}>Deploy to your Cloudflare account</a>
      <a class="btn secondary" href={REPO}>View on GitHub</a>
    </div>
  </section>

  <figure class="shot">
    <img data-light="/dashboard-light.png" data-dark="/dashboard-dark.png" src="/dashboard-light.png" alt="noomers dashboard: stats, chart and breakdown panels" loading="eager" />
    <figcaption>Dashboard shown with demo data.</figcaption>
  </figure>

  <script>
    const syncModeImgs = () => {
      const mode = document.documentElement.dataset.mode;
      const dark =
        mode === "dark" ||
        (!mode && matchMedia("(prefers-color-scheme: dark)").matches);
      for (const img of document.querySelectorAll<HTMLImageElement>("img[data-light][data-dark]")) {
        img.src = dark ? img.dataset.dark! : img.dataset.light!;
      }
    };
    syncModeImgs();
    new MutationObserver(syncModeImgs).observe(document.documentElement, { attributes: true, attributeFilter: ["data-mode"] });
  </script>

  <section class="bento">
    <span class="mono-label eyebrow">The product</span>
    <h2>See your traffic, not just totals</h2>
    <div class="bento-grid">
      <figure class="bento-card">
        <img data-light="/features/changed-light.png" data-dark="/features/changed-dark.png" src="/features/changed-light.png" alt="KPI strip showing visitors, pageviews and change badges" loading="lazy" width="1440" height="112" />
        <figcaption><b>See what changed</b><span>Period-over-period deltas on every metric.</span></figcaption>
      </figure>
      <figure class="bento-card">
        <img data-light="/features/sources-light.png" data-dark="/features/sources-dark.png" src="/features/sources-light.png" alt="Sources panel with proportion bars for referrers" loading="lazy" width="550" height="522" />
        <figcaption><b>Know where visitors come from</b><span>Referrers and campaigns with share bars.</span></figcaption>
      </figure>
      <figure class="bento-card">
        <img data-light="/features/live-light.png" data-dark="/features/live-dark.png" src="/features/live-light.png" alt="Realtime tab with live count and top pages" loading="lazy" width="1132" height="744" />
        <figcaption><b>Watch it live</b><span>Realtime visitors and top pages as they happen.</span></figcaption>
      </figure>
      <figure class="bento-card">
        <img data-light="/features/sites-light.png" data-dark="/features/sites-dark.png" src="/features/sites-light.png" alt="Sites overview cards with per-site sparklines" loading="lazy" width="1132" height="376" />
        <figcaption><b>Every site at a glance</b><span>All your sites with trends on one screen.</span></figcaption>
      </figure>
    </div>
    <p class="bento-note">Product images show demo data.</p>
  </section>

  <section class="model">
    <span class="mono-label eyebrow">Privacy model</span>
    <h2>Privacy by architecture, not policy</h2>
    <div class="model-grid">
      <div class="card event-card">
        <span class="mono-label">Stored per event</span>
        <pre aria-label="Fields noomers stores for each event">{'{'}
  <b>pathname</b>: "/pricing",
  <b>referrer</b>: "google.com",
  <b>country</b>: "DE", <b>region</b>: "BE", <b>city</b>: "Berlin",
  <b>browser</b>: "Firefox", <b>os</b>: "macOS",
  <b>device_type</b>: "desktop",
  <b>utm_source</b>: "newsletter",
  <b>event_name</b>: "signup", <b>event_properties</b>: {'{'}…{'}'},
  <b>visitor_id</b>: "a3f9…"
{'}'}</pre>
        <div class="never">
          <span class="chip"><i aria-hidden="true">✕</i>IP address</span>
          <span class="chip"><i aria-hidden="true">✕</i>User-agent string</span>
          <span class="chip"><i aria-hidden="true">✕</i>Cookies</span>
          <span class="chip"><i aria-hidden="true">✕</i>Cross-day ID</span>
        </div>
        <p class="sr-only">Noomers never stores raw IP addresses, full user-agent strings, cookies or any cross-day identifier.</p>
      </div>
      <div class="card salt-card">
        <span class="mono-label">Visitor ID · salted daily at 00:00 UTC</span>
        <div class="salt-days">
          <div class="day"><span class="d">Mon</span><span class="hash">a3f9…</span></div>
          <div class="divider" aria-hidden="true"></div>
          <div class="day"><span class="d">Tue</span><span class="hash">7c21…</span></div>
          <div class="divider" aria-hidden="true"></div>
          <div class="day"><span class="d">Wed</span><span class="hash">e08b…</span></div>
        </div>
        <p class="salt-line">Same visitor, new ID every day. Nothing links them.</p>
      </div>
    </div>
  </section>

  <section class="arch">
    <span class="mono-label eyebrow">How it runs</span>
    <h2>Runs entirely in your Cloudflare account</h2>
    <div class="account">
      <div class="account-label">Your Cloudflare account</div>
      <ol class="flow">
        <li><i aria-hidden="true"><svg viewBox="0 0 256 256"><path d="M93.46 71.51 39.52 128l53.94 56.49a12 12 0 1 1-16.92 17l-64-64a12 12 0 0 1 0-17l64-64a12 12 0 0 1 16.92 17Zm140 49-64-64a12 12 0 0 0-16.92 17l53.94 56.49-53.94 56.49a12 12 0 1 0 16.92 17l64-64a12 12 0 0 0 0-17Z"/></svg></i><b>Tracker</b><span>sends pageviews</span></li>
        <li><i aria-hidden="true"><svg viewBox="0 0 256 256"><path d="M215.79 118.17a8 8 0 0 0-5-5.66L153.18 90.9l14.66-73.33a8 8 0 0 0-13.69-7l-112 120a8 8 0 0 0 3 13l57.63 21.61L88.16 238.43a8 8 0 0 0 13.69 7l112-120a8 8 0 0 0 1.94-7.26Z"/></svg></i><b>Worker</b><span>collects + APIs</span></li>
        <li><i aria-hidden="true"><svg viewBox="0 0 256 256"><path d="M128 24a104 104 0 1 0 104 104A104.11 104.11 0 0 0 128 24Zm0 192a88 88 0 1 1 88-88 88.1 88.1 0 0 1-88 88Zm48-88a8 8 0 0 1-8 8h-72a8 8 0 0 1 0-16h72a8 8 0 0 1 8 8Z"/></svg></i><b>Durable Object</b><span>realtime + buffer</span></li>
        <li><i aria-hidden="true"><svg viewBox="0 0 256 256"><path d="M213.66 181.66 160 128l53.66-53.66a8 8 0 0 0-11.32-11.32L148 117.37V48a8 8 0 0 0-16 0v69.37L78.63 63.03A8 8 0 0 0 67.31 74.34L121 128l-53.66 53.66a8 8 0 1 0 11.32 11.32L132 138.63V208a8 8 0 0 0 16 0v-69.37l53.37 54.34a8 8 0 0 0 11.32-11.32Z"/></svg></i><b>Pipeline</b><span>Basin ingest</span></li>
        <li><i aria-hidden="true"><svg viewBox="0 0 256 256"><path d="M128 24C74.17 24 32 48.6 32 80v96c0 31.4 42.17 56 96 56s96-24.6 96-56V80c0-31.4-42.17-56-96-56Zm80 104c0 9.62-7.88 19.43-21.61 26.92C170.93 163.35 150.19 168 128 168s-42.93-4.65-58.39-13.08C55.88 147.43 48 137.62 48 128V80c0 9.62 7.88 19.43 21.61 26.92C85.07 115.35 105.81 120 128 120s42.93-4.65 58.39-13.08C200.12 99.43 208 89.62 208 80Z"/></svg></i><b>R2 / Iceberg</b><span>your warehouse</span></li>
        <li><i aria-hidden="true"><svg viewBox="0 0 256 256"><path d="M229.66 218.34 179.6 168.28a88.11 88.11 0 1 0-11.32 11.32l50.06 50.07a8 8 0 0 0 11.32-11.33ZM40 112a72 72 0 1 1 72 72 72.08 72.08 0 0 1-72-72Z"/></svg></i><b>Basin SQL</b><span>historical queries</span></li>
        <li><i aria-hidden="true"><svg viewBox="0 0 256 256"><path d="M224 200h-8V40a8 8 0 0 0-8-8h-56a8 8 0 0 0-8 8v40H88a8 8 0 0 0-8 8v40H48a8 8 0 0 0-8 8v64h-8a8 8 0 0 0 0 16h192a8 8 0 0 0 0-16ZM160 48h40v152h-40Zm-56 48h40v104h-40Zm-48 48h24v56H56Z"/></svg></i><b>Dashboard</b><span>reads SQL + DO</span></li>
      </ol>
    </div>

  </section>

  <section class="deploy">
    <span class="mono-label eyebrow">Self-host</span>
    <h2>Deploy in three steps</h2>
    <ol class="steps">
      <li><span class="num">1</span><div><b>Fork the repo</b><p>noomers carries its own infrastructure as code — nothing to provision by hand.</p></div></li>
      <li><span class="num">2</span><div><b>Add secrets</b><p>Cloudflare token, Better Auth secret, the daily salt and the API tokens.</p></div></li>
      <li><span class="num">3</span><div><b>Merge to main</b><p>Alchemy deploys through GitHub Actions with a smoke check.</p></div></li>
    </ol>
    <pre class="code">git clone {REPO}
cp .env.example .env  # fill in the values
# merge a PR → GitHub Actions deploys with Alchemy</pre>
  </section>

  <section class="two-col">
    <div class="col">
      <h2>Plausible-compatible API</h2>
      <p class="lede">A subset of Plausible's APIs. See the <a href={`${REPO}/blob/main/docs/plausible-feature-parity.md`}>parity document</a>.</p>
      <pre class="code">curl https://analytics.example.com/api/v2/query \
  -H "Authorization: Bearer $STATS_API_TOKEN" \
  -d '&#123;"site_id":"example.com","metrics":["visitors","pageviews"],"date_range":"7d"&#125;'</pre>
    </div>
    <div class="col">
      <h2>Add the script</h2>
      <p class="lede">One tag, about 3&nbsp;KB gzipped, no cookies. Works on any site you own.</p>
      <pre class="code">&lt;script defer
  src="https://analytics.example.com/tracker.js"
  data-site-id="example.com"&gt;&lt;/script&gt;</pre>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="latest">
      <h2>From the blog</h2>
      <PostList posts={latest} size="compact" headingLevel={3} showTags={false} />
    </section>
  )}
</PageLayout>
<style>
  .hero { padding: 4rem 0 2.5rem; max-width: 46rem; }
  .hero h1 { font-family: "Inter Tight Variable", "Inter Variable", -apple-system, sans-serif; font-size: clamp(2.4rem, 5vw, 3.8rem); margin: 0 0 1rem; line-height: 1.05; letter-spacing: -0.025em; font-weight: 400; }
  .hero h1 em { font-style: normal; color: var(--color-kumo-brand); }
  .sub { font-size: 1.15rem; color: var(--color-kumo-subtle); max-width: 62ch; text-wrap: pretty; }
  .btns { display: flex; gap: .75rem; margin-top: 1.75rem; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; height: 42px; padding: 0 1.2rem; font-weight: 600; text-decoration: none; }
  .btn.cta { background: var(--color-kumo-brand); color: var(--brand-ink); padding: 0 1.5rem; }
  .btn.secondary { background: transparent; border: 1px solid var(--color-kumo-control-line); color: var(--color-kumo-default); padding: 0 1.5rem; }
  .kw { background: var(--color-kumo-brand-tint); color: var(--color-kumo-brand-text); border-radius: 8px; padding: 0 .14em; }
  .eyebrow { display: block; margin-bottom: 1rem; }
  .shot { margin: 2rem 0 1rem; }
  .shot img { width: 100%; border: 1px solid var(--color-kumo-line); border-radius: 14px; background: #fff; box-shadow: 0 1px 2px rgba(28,25,23,.04), 0 12px 32px rgba(28,25,23,.08); }
  :global(html[data-mode="dark"]) .shot img { box-shadow: none; }
  .shot figcaption { margin-top: .6rem; font-size: .85rem; color: var(--color-kumo-subtle); }
  section { padding: 6rem 0; margin: 0; }
  section:nth-of-type(even) {
    background: var(--color-kumo-elevated);
    border-block: 1px solid var(--color-kumo-hairline);
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding-left: calc(50vw - 50%);
    padding-right: calc(50vw - 50%);
  }
  section h2 { font-size: 2rem; letter-spacing: -0.02em; text-wrap: balance; }
  section h2::before { content: ""; display: block; }
  @media (max-width: 860px) { section { padding: 4rem 0; } }
  h2 { font-size: 1.6rem; margin-bottom: 1rem; letter-spacing: -0.01em; }
  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .card { border: 1px solid var(--color-kumo-line); background: var(--color-kumo-elevated); border-radius: 14px; padding: 1.5rem; }
  .card h3 { font-size: 1.05rem; margin: 0 0 1rem; }
  .card ul { margin: 0; padding: 0; list-style: none; color: var(--color-kumo-subtle); }
  .card li { display: flex; align-items: baseline; gap: .7rem; margin: .5rem 0; font-size: .95rem; }
  .ic { font-weight: 700; flex: none; }
  .ic.check { color: var(--color-kumo-brand); }
  .ic.x { color: var(--color-kumo-subtle); }
  .model .note { margin-top: 1.25rem; color: var(--color-kumo-subtle); max-width: 560px; text-wrap: pretty; }
  .account { border: 1px dashed var(--color-kumo-control-line); border-radius: 14px; padding: 1.5rem; position: relative; }
  .account-label { position: absolute; top: -0.7em; left: 1.25rem; background: var(--color-kumo-canvas); padding: 0 .5rem; font-size: .8rem; color: var(--color-kumo-subtle); }
  .flow { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: .5rem; align-items: stretch; }
  .flow li { border: 1px solid var(--color-kumo-line); background: var(--color-kumo-elevated); border-radius: 10px; padding: .6rem .7rem; font-size: .85rem; position: relative; }
  .flow li + li::before { content: "→"; position: absolute; left: -0.45rem; top: 50%; transform: translateY(-50%); color: var(--color-kumo-subtle); font-size: .8rem; }
  .flow b { display: block; font-size: .9rem; }
  .flow span { font-size: .75rem; color: var(--color-kumo-subtle); }
  .lede { color: var(--color-kumo-subtle); max-width: 68ch; font-size: 1rem; text-wrap: pretty; }
  .code { font-family: ui-monospace, monospace; font-size: .82rem; background: var(--color-kumo-recessed); padding: 1rem; border-radius: 10px; overflow-x: auto; white-space: pre-wrap; word-break: break-all; }
  .steps { list-style: none; padding: 0; margin: 0 0 1.25rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .steps li { display: flex; gap: .9rem; }
  .steps .num { flex: none; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--color-kumo-control-line); display: grid; place-items: center; font-size: .85rem; font-weight: 600; }
  .steps b { display: block; margin-bottom: .25rem; }
  .steps p { margin: 0; color: var(--color-kumo-subtle); font-size: .9rem; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .two-col .code { margin-top: .75rem; }

  /* feature bento */
  .bento-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-top: 1.5rem; }
  .bento-card {
    margin: 0; border: 1px solid var(--color-kumo-line); background: var(--color-kumo-elevated);
    border-radius: 14px; overflow: hidden;
    transition: transform 0.18s ease;
  }
  .bento-card img {
    display: block; width: 100%; aspect-ratio: 16/10; height: auto;
    object-fit: cover; object-position: top left;
    border-bottom: 1px solid var(--color-kumo-hairline);
    background: var(--color-kumo-recessed);
  }
  .bento-card figcaption { padding: 1rem 1.25rem 1.1rem; }
  .bento-card b { display: block; font-family: "Inter Tight Variable", "Inter Variable", -apple-system, sans-serif; font-weight: 400; font-size: 1.05rem; letter-spacing: -0.02em; }
  .bento-card span { font-size: 0.9rem; color: var(--color-kumo-subtle); }
  .bento-note { margin-top: 0.75rem; font-size: 0.8rem; color: var(--color-kumo-subtle); }
  @media (prefers-reduced-motion: no-preference) {
    .bento-card:hover { transform: translateY(-2px); }
  }

  /* privacy: anatomy + salt timeline */
  .model-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 1.25rem; margin-top: 1.5rem; }
  .event-card pre {
    margin: 0.9rem 0 1rem; font-family: "IBM Plex Mono", ui-monospace, Menlo, monospace;
    font-size: 0.8rem; line-height: 1.7; color: var(--color-kumo-default);
    white-space: pre-wrap; word-break: break-word;
  }
  .event-card pre b { color: var(--color-kumo-brand); font-weight: 500; }
  .never { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .never .chip {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: "IBM Plex Mono", ui-monospace, Menlo, monospace; font-size: 11px; letter-spacing: 0.02em;
    padding: 3px 10px; border-radius: 999px;
    border: 1px dashed var(--color-kumo-control-line);
    color: var(--color-kumo-subtle); text-decoration: line-through;
  }
  .never .chip i { font-style: normal; text-decoration: none; color: var(--color-kumo-subtle); }
  .salt-card { display: flex; flex-direction: column; gap: 1.25rem; justify-content: space-between; }
  .salt-days { display: grid; grid-template-columns: 1fr 1px 1fr 1px 1fr; align-items: stretch; flex: 1; }
  .salt-days .day {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 1rem; padding: 2rem 0.5rem; flex: 1;
  }
  .salt-days .d { font-family: "IBM Plex Mono", ui-monospace, Menlo, monospace; font-size: 13px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-kumo-subtle); }
  .salt-days .hash {
    font-family: "IBM Plex Mono", ui-monospace, Menlo, monospace; font-size: 15px;
    padding: 6px 16px; border-radius: 999px;
    background: var(--color-kumo-brand-tint); color: var(--color-kumo-brand-text);
  }
  .salt-days .divider {
    border-left: 1px dashed var(--color-kumo-control-line);
    position: relative;
  }
  .salt-days .divider::after {
    content: "00:00 UTC"; position: absolute; top: 50%; left: 0;
    transform: translate(-50%, -50%) rotate(-90deg);
    font-family: "IBM Plex Mono", ui-monospace, Menlo, monospace; font-size: 9px;
    letter-spacing: 0.04em; color: var(--color-kumo-subtle);
    background: var(--color-kumo-elevated); padding: 0 2px;
  }

  .salt-line { margin: 0; font-size: 0.95rem; color: var(--color-kumo-subtle); }

  /* arch icons */
  .flow li i {
    display: grid; place-items: center; width: 32px; height: 32px;
    border-radius: 8px; background: var(--color-kumo-tint); color: var(--color-kumo-brand);
    margin-bottom: 0.5rem;
  }
  .flow li i svg { width: 18px; height: 18px; fill: currentColor; }

  /* deploy icons */
  .steps li i {
    display: grid; place-items: center; flex: none; width: 32px; height: 32px;
    border-radius: 8px; background: var(--color-kumo-tint); color: var(--color-kumo-brand);
  }
  .steps li i svg { width: 18px; height: 18px; fill: currentColor; }

  .sr-only {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }

  @media (max-width: 860px) {
    .cards, .steps, .two-col, .bento-grid, .model-grid { grid-template-columns: 1fr; }
    .bento-card img { aspect-ratio: 16/10; height: auto; }
    .flow { grid-template-columns: 1fr; gap: .4rem; }
    .flow li + li::before { content: ""; }
    .flow li + li::after { content: "↓"; position: absolute; left: 1rem; top: -0.55rem; color: var(--color-kumo-subtle); font-size: .7rem; }
  }
</style>
