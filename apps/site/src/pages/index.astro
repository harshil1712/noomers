---
import PageLayout from "../components/PageLayout.astro";
import PostList from "../components/PostList.astro";
import { PROJECT } from "#project";
import { getPublishedPosts } from "../lib/posts";

const latest = (await getPublishedPosts()).slice(0, 3);
const description =
  "Privacy-first, self-hosted web analytics on Cloudflare — a lightweight tracker, a realtime dashboard, and Plausible-compatible APIs, all inside your own account.";
const REPO = "https://github.com/harshil1712/noomers";
---
<PageLayout title={`${PROJECT.productName}: privacy-first self-hosted analytics`} description={description} width="wide">
  <section class="hero">
    <h1>Analytics that know <em>less</em>, not more.</h1>
    <p class="sub">
      Self-hosted, privacy-first web analytics that run entirely in your own
      Cloudflare account — a lightweight tracker, a realtime dashboard, and
      Plausible-compatible APIs.
    </p>
    <div class="btns">
      <a class="btn cta" href={`${REPO}#deployment`}>Deploy to your Cloudflare account</a>
      <a class="btn secondary" href={REPO}>View on GitHub</a>
    </div>
  </section>

  <figure class="shot">
    <picture>
      <source srcset="/dashboard-dark.png" media="(prefers-color-scheme: dark)" />
      <img src="/dashboard-light.png" alt="noomers dashboard: stats, chart and breakdown panels" loading="eager" />
    </picture>
    <figcaption>Dashboard shown with demo data.</figcaption>
  </figure>

  <section class="model">
    <div class="col stores">
      <h2>What noomers stores</h2>
      <ul>
        <li>Page URL and referrer</li>
        <li>Country, region and city (from the edge, not a database)</li>
        <li>Browser, OS and device class</li>
        <li>UTM campaign fields</li>
        <li>Custom event names and properties you send</li>
        <li>A site-scoped, salted visitor ID — rotated daily</li>
      </ul>
    </div>
    <div class="col never">
      <h2>What it never stores</h2>
      <ul>
        <li>Raw IP addresses</li>
        <li>Full user-agent strings</li>
        <li>Cookies or cross-site identifiers</li>
        <li>Anything that links a visitor across days</li>
      </ul>
    </div>
    <p class="note">
      Every event is hashed into a site-scoped, hostname-scoped visitor ID using
      a salt that rotates at 00:00 UTC. Yesterday's IDs can't be linked to
      today's — sessions never span midnight.
    </p>
  </section>

  <section class="arch">
    <h2>Runs in your Cloudflare account</h2>
    <ol class="flow">
      <li><b>Tracker</b><span>sends pageviews</span></li>
      <li><b>Worker</b><span>collects + serves APIs</span></li>
      <li><b>Durable Object</b><span>realtime + buffering</span></li>
      <li><b>Pipeline</b><span>Basin ingest</span></li>
      <li><b>R2 / Iceberg</b><span>your warehouse</span></li>
      <li><b>Basin SQL</b><span>historical queries</span></li>
      <li><b>Dashboard</b><span>reads SQL + DO</span></li>
    </ol>
    <p class="lede">No data leaves your account — the worker, object store and SQL all live under your credentials.</p>
  </section>

  <section class="deploy">
    <h2>Deploy in three steps</h2>
    <ol class="steps">
      <li><b>Fork the repo</b> — it carries its own infrastructure as code.</li>
      <li><b>Add secrets</b> — Cloudflare token, Better Auth secret, salt and tokens.</li>
      <li><b>Merge to main</b> — Alchemy deploys through GitHub Actions.</li>
    </ol>
    <pre class="code">git clone {REPO}
cp .env.example .env  # fill in the values
# merge a PR → GitHub Actions deploys with Alchemy</pre>
  </section>

  <section class="api">
    <h2>Plausible-compatible API</h2>
    <p class="lede">A subset of Plausible's Events, Sites and Stats APIs — keep your integrations, dashboards and imports. Coverage lives in the <a href={`${REPO}/blob/main/docs/plausible-feature-parity.md`}>parity document</a>.</p>
    <pre class="code">curl https://analytics.example.com/api/v2/query \
  -H "Authorization: Bearer $STATS_API_TOKEN" \
  -d '&#123;"site_id":"example.com","metrics":["visitors","pageviews"],"date_range":"7d"&#125;'</pre>
  </section>

  <section class="install">
    <h2>Add the script</h2>
    <pre class="code">&lt;script defer
  src="https://analytics.example.com/tracker.js"
  data-site-id="example.com"&gt;&lt;/script&gt;</pre>
  </section>

  {latest.length > 0 && (
    <section class="latest">
      <h2>From the blog</h2>
      <PostList posts={latest} size="compact" headingLevel={3} showTags={false} />
    </section>
  )}
</PageLayout>
<style>
  .hero { padding: 3.5rem 0 2rem; max-width: 46rem; }
  .hero h1 { font-size: clamp(2.4rem, 5vw, 3.8rem); margin: 0 0 1rem; line-height: 1.05; letter-spacing: -0.02em; font-weight: 700; }
  .hero h1 em { font-style: normal; color: var(--color-kumo-brand); }
  .sub { font-size: 1.15rem; color: var(--color-kumo-subtle); }
  .btns { display: flex; gap: .75rem; margin-top: 1.75rem; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; height: 42px; padding: 0 1.2rem; border-radius: 10px; font-weight: 600; text-decoration: none; }
  .btn.cta { background: var(--color-kumo-brand); color: var(--brand-ink); }
  .btn.secondary { border: 1px solid var(--color-kumo-control-line); color: var(--color-kumo-default); }
  .shot { margin: 2rem 0 1rem; }
  .shot img { width: 100%; border: 1px solid var(--color-kumo-line); border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,.08); }
  .shot figcaption { margin-top: .6rem; font-size: .85rem; color: var(--color-kumo-subtle); }
  section { margin: 3rem 0; }
  h2 { font-size: 1.6rem; margin-bottom: 1rem; letter-spacing: -0.01em; }
  .model { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .model .col ul { margin: 0; padding-left: 1.2rem; color: var(--color-kumo-subtle); }
  .model .col li { margin: .35rem 0; }
  .model .note { grid-column: 1 / -1; color: var(--color-kumo-subtle); max-width: 62ch; }
  .flow { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
  .flow li { border: 1px solid var(--color-kumo-control-line); background: var(--color-kumo-elevated); border-radius: 10px; padding: .6rem .9rem; }
  .flow b { display: block; }
  .flow span { font-size: .8rem; color: var(--color-kumo-subtle); }
  .flow li::after { content: "→"; margin-left: .6rem; color: var(--color-kumo-subtle); }
  .flow li:last-child::after { content: ""; }
  .lede { color: var(--color-kumo-subtle); max-width: 62ch; }
  .code, .acard pre { font-family: ui-monospace, monospace; font-size: .82rem; background: var(--color-kumo-recessed); padding: 1rem; border-radius: 10px; overflow-x: auto; }
  .steps { padding-left: 1.2rem; color: var(--color-kumo-subtle); }
  .steps li { margin: .5rem 0; }
  @media (max-width: 860px) {
    .model { grid-template-columns: 1fr; }
    .flow { flex-direction: column; align-items: flex-start; }
    .flow li::after { content: "↓"; }
  }
</style>
