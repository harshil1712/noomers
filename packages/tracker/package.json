{
    "name": "@noomers/tracker",
    "version": "3.4.1",
    "descriptrion": "noomers tracking library for recording pageviews",
    "homepage": "https://noomers.dev",
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "build": "vp build -c vite.loader.config.ts && vp build -c vite.module.config.ts && vp build -c vite.server.config.ts",
        "test": "TZ=EST vp test",
        "test:integration": "playwright test && vitest run --config vitest.integration.config.ts",
        "start": "node ./integration/server.js",
        "typecheck": "tsc",
        "check": "vp check",
        "prepare": "vp config"
    },
    "devDependencies": {
        "@playwright/test": "^1.49.1",
        "@types/node": "24.19.2",
        "jsdom": "^23.2.0",
        "typescript": "7.0.2",
        "vite": "catalog:",
        "vite-plugin-dts": "^4.4.0",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "catalog:"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/module/index.d.ts",
            "default": "./dist/module/index.js"
        },
        "./server": {
            "types": "./dist/server/index.d.ts",
            "default": "./dist/server/index.js"
        }
    }
}
