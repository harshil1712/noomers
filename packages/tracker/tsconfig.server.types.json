{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "emitDeclarationOnly": true,
        "noEmit": false,
        "outDir": "dist/server",
        "rootDir": "src"
    },
    "include": [
        "src/server",
        "src/shared"
    ],
    "exclude": [
        "**/__tests__",
        "integration",
        "dist",
        "node_modules"
    ]
}
