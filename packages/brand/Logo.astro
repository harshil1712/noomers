---
interface Props { size?: number; markOnly?: boolean; class?: string }
const { size = 24, markOnly = false, class: className } = Astro.props;
const r = size * 0.29;
const stroke = Math.max(2, size * 0.08);
const gap = size * 0.1;
const w = r * 4 + gap + stroke;
const h = r * 2 + stroke * 2;
---
<span class:list={["inline-flex items-center gap-2", className]}>
  <svg width={w} height={h} viewBox={`0 0 ${w} ${h}`} aria-hidden="true">
    <circle cx={r} cy={r + stroke} r={r} fill="var(--color-kumo-brand)" />
    <circle
      cx={r * 3 + gap + stroke / 2}
      cy={r + stroke}
      r={r}
      fill="none"
      stroke="var(--color-kumo-brand)"
      stroke-width={stroke}
    />
  </svg>
  {!markOnly && (
    <span class="font-display text-lg font-bold tracking-tight" style="color: var(--color-kumo-default)">
      noomers
    </span>
  )}
</span>
