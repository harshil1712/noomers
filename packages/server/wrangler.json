{
  "main": "./workers/app.ts",
  "name": "noomers-local",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "./build/client"
  },
  "d1_databases": [
    {
      "binding": "GOALS_DB",
      "database_name": "noomers-goals",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SITE_EVENTS",
        "class_name": "SiteEvents"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SiteEvents"
      ]
    }
  ],
  "pipelines": [
    {
      "binding": "EVENT_STREAM",
      "stream": "00000000000000000000000000000000"
    }
  ],
  "ratelimits": [
    {
      "name": "COLLECT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
}